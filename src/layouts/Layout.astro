      <span class="classified">FOR YOUR EYES ONLY</span>
    </header>
    <main>
      <slot />
      <footer>
        <span>DOUBLE O / DATE NIGHT</span>
        <p>An unofficial fan project. Best enjoyed with a martini.</p>
        <span>THE BOND DOSSIER</span>
      </footer>
    </main>
  </body>
</html>
