---
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Double O — Bond Night',
  description = 'Your James Bond movie mission. Track every film, one date night at a time.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href={import.meta.env.BASE_URL}>
        DOUBLE O<span> / </span>DATE NIGHT
      </a>
      <span class="classified">FOR YOUR EYES ONLY</span>
    </header>
    <main>
      <slot />
      <footer>
        <span>DOUBLE O / DATE NIGHT</span>
        <p>An unofficial fan project. Best enjoyed with a martini.</p>
        <span>THE BOND DOSSIER</span>
      </footer>
    </main>
  </body>
</html>
