    <meta
      name="description"
      content="Your James Bond movie mission. Track every film, one date night at a time."
    />
    <title>Double O — Bond Night</title>
  </head>
  <body>
    <header>
      <a class="brand" href={import.meta.env.BASE_URL}>
        DOUBLE O<span> / </span>DATE NIGHT
