---
interface Props {
  active: 'movies' | 'games';
}
const { active } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav class="section-tabs" aria-label="Dossier sections">
  <a
    href={`${base}/`}
    class:list={{ selected: active === 'movies' }}
    aria-current={active === 'movies' ? 'page' : undefined}
  >
    <span aria-hidden="true">◧</span> Movies
  </a>
  <a
    href={`${base}/games/`}
    class:list={{ selected: active === 'games' }}
    aria-current={active === 'games' ? 'page' : undefined}
  >
    <span aria-hidden="true">✣</span> Games
  </a>
</nav>
